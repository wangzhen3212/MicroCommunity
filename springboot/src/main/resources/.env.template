#!/bin/bash
# =====================================================
# MicroCommunity 环境变量配置模板
# =====================================================
# 使用说明：
#   1. 复制此文件为 .env
#   2. 根据实际环境修改以下配置
#   3. 启动前执行: source .env
#
# 配置对应关系说明：
#   - 环境变量名采用 Spring Boot 标准格式：前缀_层级_层级_属性名
#   - 例如：SYS_CLIENT_SERVER_URL 对应配置 sys.client.server-url

# =====================================================
# 服务器配置
# =====================================================
# 服务端口
export SERVER_PORT=8008
# Tomcat URI编码
export SERVER_TOMCAT_URI_ENCODING=UTF-8

# =====================================================
# 日志配置
# =====================================================
# 日志文件存放路径
export LOGGING_FILE_PATH=/www/wwwlogs/java/springboot

# =====================================================
# sys-client 客户机模块配置
# =====================================================
# 是否开启客户机功能（true/false）
export SYS_CLIENT_ENABLED=true
# 上位机 WebSocket 服务端地址（必填，enabled=true 时生效）
export SYS_CLIENT_SERVER_URL=ws://127.0.0.1:8080/ws/host
# 上位机管理员分配的认证 KEY（必填，enabled=true 时生效）
export SYS_CLIENT_AUTH_KEY=a17c961232b4432e8fe0854783c477fe784c423047386a41b9257aff3d2449b6
# 心跳发送间隔（秒），默认30秒
export SYS_CLIENT_HEARTBEAT_INTERVAL=30
# 断线重连最大间隔（秒），默认60秒
export SYS_CLIENT_RECONNECT_MAX_INTERVAL=60
# 上位机未上线时的注册重试间隔（秒），默认600秒（10分钟）
export SYS_CLIENT_HOST_RETRY_INTERVAL=600
# 上位机 HTTP 代理地址，如 http://host:8080/proxy/out（可选）
export SYS_CLIENT_PROXY_URL=http://127.0.0.1:8080/proxy/out

# =====================================================
# Spring 基础配置
# =====================================================
# Spring Profiles (dev/test/prod/share)
export SPRING_PROFILES_ACTIVE=share
# 应用名称
export SPRING_APPLICATION_NAME=boot-service

# =====================================================
# 文件上传配置
# =====================================================
# 最大文件大小
export SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=50MB
# 最大请求大小
export SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=50MB

# =====================================================
# HTTP 编码配置
# =====================================================
export SPRING_HTTP_ENCODING_CHARSET=UTF-8
export SPRING_HTTP_ENCODING_ENABLED=true
export SPRING_HTTP_ENCODING_FORCE=true

# =====================================================
# Redis 配置
# =====================================================
# Redis 数据库索引
export SPRING_REDIS_DATABASE=0
# Redis 地址
export SPRING_REDIS_HOST=127.0.0.1
# Redis 端口
export SPRING_REDIS_PORT=6379
# Redis 密码
export SPRING_REDIS_PASSWORD=cszyzh
# Redis 连接池最大连接数
export SPRING_REDIS_POOL_MAX_ACTIVE=300
# Redis 连接池最大等待时间（毫秒）
export SPRING_REDIS_POOL_MAX_WAIT=3000
# Redis 连接池最大空闲连接数
export SPRING_REDIS_POOL_MAX_IDLE=50
# Redis 连接池最小空闲连接数
export SPRING_REDIS_POOL_MIN_IDLE=20
# Redis 超时时间（毫秒）
export SPRING_REDIS_POOL_TIMEOUT=0

# =====================================================
# Activiti 工作流配置
# =====================================================
# 是否自动更新数据库Schema（true/false）
export SPRING_ACTIVITI_DATABASE_SCHEMA_UPDATE=false

# =====================================================
# 数据源配置（MySQL）
# =====================================================
# 数据库连接URL
export SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:13306/TT?useUnicode=true&characterEncoding=utf-8&serverTimezone=GMT%2B8
# 数据库用户名
export SPRING_DATASOURCE_USERNAME=TT
# 数据库密码
export SPRING_DATASOURCE_PASSWORD=qq272730334
# 数据源类型
export SPRING_DATASOURCE_TYPE=com.alibaba.druid.pool.DruidDataSource
# JDBC驱动类名
export SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# =====================================================
# Druid 连接池配置
# =====================================================
# 初始化连接数
export SPRING_DATASOURCE_DRUID_INITIAL_SIZE=5
# 最大活跃连接数
export SPRING_DATASOURCE_DRUID_MAX_ACTIVE=20
# 最小空闲连接数
export SPRING_DATASOURCE_DRUID_MIN_IDLE=5
# 最大等待时间（毫秒）
export SPRING_DATASOURCE_DRUID_MAX_WAIT=60000

# =====================================================
# Feign 客户端配置
# =====================================================
# 连接超时时间（毫秒）
export FEIGN_CLIENT_CONFIG_DEFAULT_CONNECT_TIMEOUT=10000
# 读取超时时间（毫秒）
export FEIGN_CLIENT_CONFIG_DEFAULT_READ_TIMEOUT=20000

# =====================================================
# 启动命令示例
# =====================================================
# source .env && java -jar MicroCommunityBoot.jar
