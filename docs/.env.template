# ============================================
# MicroCommunity 环境变量配置模板文件
# 对应 springboot/src/main/resources/application-dev.yml
# 基于 v1.9.1 分支配置参数，复制此文件为 .env 并修改所需参数
# ============================================

# 服务器配置
SERVER_PORT=8008

# ========== sys-client 客户机模块配置 ==========
# 是否开启客户机功能（默认关闭，开启请改为 true）
SYS_CLIENT_ENABLED=false
# 上位机 WebSocket 服务端地址（必填，enabled=true 时生效）
SYS_CLIENT_SERVER_URL=ws://127.0.0.1:8080/ws/host
# 上位机管理员分配的认证 KEY（必填，enabled=true 时生效）
SYS_CLIENT_AUTH_KEY=your-auth-key-here
# 上位机 HTTP 代理地址，如 http://host:8080/proxy/out（可选）
SYS_CLIENT_PROXY_URL=http://127.0.0.1:8080/proxy/out

# ========== Redis 配置 ==========
SPRING_REDIS_HOST=127.0.0.1
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=hc

# ========== 数据库配置 ==========
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/TT?useUnicode=true&characterEncoding=utf-8&serverTimezone=GMT%2B8
SPRING_DATASOURCE_USERNAME=TT
SPRING_DATASOURCE_PASSWORD=hc12345678
